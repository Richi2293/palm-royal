# Generated Blender scenes. The finished city is 407 MB of packed textures,
# well past what GitHub accepts, and the earlier stages are intermediates that
# the build scripts recreate. Rebuild them by running the pipeline in order.
*.blend
*.blend1

# Third-party assets downloaded at build time by download_assets.py and
# download_cafe_assets.py. Only the manifests are tracked, so the exact set of
# source assets stays reproducible without committing ~500 MB of binaries.
assets/*
!assets/*.json
!assets/*/
assets/*/*
!assets/*/*.json

# Python bytecode
__pycache__/

# macOS
.DS_Store
