# Generated Blender scenes. Rebuild them by running the build scripts in order.
# The two lightweight scenes are tracked so the project can be opened without
# running the pipeline first. The detailed ones are 280-430 MB and stay out.
*.blend
*.blend1
!scenes/palm-royal.blend
!scenes/coastal-city.blend

# Third-party assets downloaded at build time by download_assets.py and
# download_cafe_assets.py. Only the manifests are tracked, so the exact set of
# source assets stays reproducible without committing ~500 MB of binaries.
assets/*
!assets/*.json
!assets/*/
assets/*/*
!assets/*/*.json

# Python bytecode
__pycache__/

# macOS
.DS_Store
